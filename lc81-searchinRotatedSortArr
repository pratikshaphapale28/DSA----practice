bool search(vector<int>& nums, int target) {
         int low = 0, high = nums.size() - 1;
        while (low <= high) {
            int mid = (low + high) / 2;
            if (nums[mid] == target)
                return true;
            if(nums[low] == nums[mid] && nums[mid] == nums[high]){// imp 
                low++; // shrink th array until and unless they all are not equal
                high--;
                continue;
            }    

            if (nums[low] <=
                nums[mid]) { // means lrft half is sorted beacuse array is
                             // rotated so we have to check
                if (nums[low] <= target && target <= nums[mid]) {
                    high = mid - 1;
                } else
                    low = mid + 1;
            } else { // means right half is sorted
                if (nums[mid] <= target && target <= nums[high]) {
                    low = mid + 1;
                } else
                    high = mid - 1;
            }
        }
       return false;
    }
